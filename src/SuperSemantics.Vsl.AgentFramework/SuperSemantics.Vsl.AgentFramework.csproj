<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SuperSemantics.Vsl.AgentFramework</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>SuperSemantics.Vsl.AgentFramework</PackageId>
    <Description>Microsoft Agent Framework adapter for VSL governance primitives: compiles PreNodes and Invariants into gates that run before a tool call, and aborts the run fail-closed on denial.</Description>
    <PackageTags>vsl;governance;ai-agents;agent-framework;microsoft-agent-framework</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/supersemantics/VSL-Microsoft-agent-framework.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/supersemantics/VSL-Microsoft-agent-framework.NET</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tested against 1.28.0. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SuperSemantics.Vsl builds from the external/VSL-Core.NET submodule, pinned to tag v0.1.1
         (clone with recurse-submodules). The packed package depends on SuperSemantics.Vsl 0.1.1
         from NuGet. -->
    <ProjectReference Include="..\..\external\VSL-Core.NET\src\SuperSemantics.Vsl\SuperSemantics.Vsl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SuperSemantics.Vsl.AgentFramework.Tests" />
  </ItemGroup>

</Project>
